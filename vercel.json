{
  "crons": [
    {
      "path": "/api/cron/reset-usage",
      "schedule": "0 0 * * *",
      "description": "Daily maintenance + usage cleanup (midnight UTC)"
    },
    {
      "path": "/api/cron/generate-content",
      "schedule": "0 6 * * 2,5",
      "description": "SEO content generation — 2 blog posts (Tue & Fri at 6am UTC)"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "0 8 * * 1",
      "description": "Weekly CEO analytics report (Monday 8am UTC)"
    }
  ],
  "functions": {
    "app/api/tools/pdf-summarize/route.ts": {
      "maxDuration": 60
    },
    "app/api/tools/youtube-summarize/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/generate-content/route.ts": {
      "maxDuration": 300
    }
  }
}
