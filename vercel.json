{
  "crons": [
    {
      "path": "/api/cron/reset-usage",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/generate-content",
      "schedule": "0 6 * * 2,5"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "0 8 * * 1"
    }
  ],
  "functions": {
    "app/api/tools/pdf-summarize/route.ts": {
      "maxDuration": 60
    },
    "app/api/tools/youtube-summarize/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/generate-content/route.ts": {
      "maxDuration": 300
    }
  }
}
