# ============================================================
# TOOLORA — Environment Variables
# Copy this file to .env.local and fill in all values.
# ============================================================

# ---- SITE CONFIG -----------------------------------------------
NEXT_PUBLIC_SITE_URL=https://toolora.com
NEXT_PUBLIC_SITE_NAME=Toolora

# ---- SUPABASE (Free tier — https://supabase.com) ---------------
# Create a project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJ...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJ...

# ---- GROQ AI (Free tier — https://console.groq.com) -----------
# Sign up → API Keys → Create key
# Free: 14,400 req/day with LLaMA 3 70B
GROQ_API_KEY=gsk_...

# ---- GOOGLE GEMINI (Backup AI — https://ai.google.dev) --------
# Free: 1,500 req/day
GOOGLE_AI_API_KEY=AIza...

# ---- STRIPE (International payments — https://stripe.com) ------
# Create account → Developers → API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create in Stripe dashboard)
STRIPE_PRO_PRICE_ID=price_...
STRIPE_UNLIMITED_PRICE_ID=price_...

# ---- RAZORPAY (Indian payments — https://razorpay.com) --------
# Create account → Settings → API Keys → Generate Key
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...

# Razorpay Plan IDs (create via dashboard or API)
RAZORPAY_PRO_PLAN_ID=plan_...
RAZORPAY_UNLIMITED_PLAN_ID=plan_...

# ---- RESEND EMAIL (https://resend.com — free 3,000/month) ------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@toolora.com

# ---- GOOGLE ANALYTICS & ADSENSE --------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# ---- ADMIN -------------------------------------------------------
# Set a strong secret for admin access
ADMIN_SECRET=change-this-to-a-very-long-random-string
ADMIN_EMAIL=founder@toolora.com

# ---- CRON JOBS ---------------------------------------------------
# Used to secure /api/cron/* routes
CRON_SECRET=another-very-long-random-string
