# ============================================================
# FORMLY — Environment Variables
# Copy this file to .env.local and fill in all values.
# ============================================================

# ---- SITE CONFIG -----------------------------------------------
NEXT_PUBLIC_SITE_URL=https://formly.tools
NEXT_PUBLIC_SITE_NAME=Formly

# ---- SUPABASE (Free tier — https://supabase.com) ---------------
# Create a project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJ...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJ...

# ---- GROQ AI (Free tier — https://console.groq.com) -----------
# Sign up → API Keys → Create key
# Free: 14,400 req/day with LLaMA 3 70B
GROQ_API_KEY=gsk_...

# ---- GOOGLE GEMINI (Backup AI — https://ai.google.dev) --------
# Free: 1,500 req/day
GOOGLE_AI_API_KEY=AIza...

# ---- DODOPAYMENTS (https://dodopayments.com) ------------------
# Sign up → Dashboard → Developer → API Keys
# Handles all global payments + GST/VAT compliance automatically
DODO_PAYMENTS_API_KEY=...
DODO_PAYMENTS_WEBHOOK_KEY=...
DODO_PAYMENTS_ENVIRONMENT=live_mode

# Product IDs — create products in DodoPayments dashboard
# Pro: $9.99/month (subscription), Unlimited: $19.99/month (subscription), Day Pass: $1.99 (one-time)
DODO_PRO_PRODUCT_ID=prd_...
DODO_UNLIMITED_PRODUCT_ID=prd_...
DODO_DAY_PASS_PRODUCT_ID=prd_...

# ---- RESEND EMAIL (https://resend.com — free 3,000/month) ------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@formly.tools

# ---- GOOGLE ANALYTICS & ADSENSE --------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
# Ad unit slot IDs: AdSense dashboard → Ads → Ad units → copy slot ID from code snippet
# Without these, manual ad units won't render (Auto Ads still works if enabled in AdSense dashboard)
NEXT_PUBLIC_ADSENSE_BANNER_SLOT=
NEXT_PUBLIC_ADSENSE_SIDEBAR_SLOT=

# ---- ADMIN -------------------------------------------------------
# Set a strong secret for admin access
ADMIN_SECRET=change-this-to-a-very-long-random-string
ADMIN_EMAIL=founder@formly.tools

# ---- CRON JOBS ---------------------------------------------------
# Used to secure /api/cron/* routes
CRON_SECRET=another-very-long-random-string

# ---- SEO TRAFFIC AGENT -------------------------------------------
# Option A — OAuth2 refresh token (recommended, works with any Google account)
#
# Setup:
# 1. Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
#    Type: Web application → Add redirect URI: https://developers.google.com/oauthplayground → Save
# 2. Go to https://developers.google.com/oauthplayground
#    Gear icon → "Use your own OAuth credentials" → paste Client ID + Secret
# 3. Find "Search Console API v3" → select webmasters.readonly scope → Authorize
#    Sign in with the Google account that owns formly.tools in Search Console
# 4. Click "Exchange authorization code for tokens" → copy Refresh token
#
GSC_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GSC_CLIENT_SECRET=GOCSPX-...
GSC_REFRESH_TOKEN=1//...
GSC_SITE_URL=https://formly.tools
#
# Option B — Service account (only works with Google Workspace + domain-wide delegation)
# GSC_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
#
# Dashboard: https://formly.tools/dashboard/seo?secret=YOUR_ADMIN_SECRET
# Manual run: curl -X POST https://formly.tools/api/admin/seo-agent -H "Authorization: YOUR_ADMIN_SECRET"
