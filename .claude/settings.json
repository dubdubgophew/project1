{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Skill",
      "WebSearch",
      "WebFetch",
      "Bash(npx tsc --noEmit *)",
      "Bash(git -C * status *)",
      "Bash(git -C * log *)",
      "Bash(git -C * branch *)",
      "Bash(git -C * diff *)",
      "Bash(git -C * show *)",
      "Bash(git -C * stash list *)"
    ]
  }
}
